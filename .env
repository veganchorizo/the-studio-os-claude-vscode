# Point the stack at your own Ollama instance instead of a bundled container.
# On Linux, host.docker.internal resolves to the host via the host-gateway
# mapping added in docker-compose.yml. For a remote server, use its IP/hostname:
#   OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models your Ollama server must have pulled (ollama pull <model>):
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Required. Change this to a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

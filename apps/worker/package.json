{
  "name": "@studio-os/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@studio-os/shared": "workspace:*",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1",
    "undici": "^6.19.7"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
